# LLM provider
LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=http://metis.local:1240/v1
OPENAI_COMPATIBLE_MODEL=qwen3.6-35b-a3b-mtp
OPENAI_COMPATIBLE_API_KEY=lm-studio
OPENAI_COMPATIBLE_REASONING_EFFORT=none
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120

# Optional premium planner profile (`planner_profile=deep`)
DEEP_PLANNER_BASE_URL=http://athena.local:1240/v1
DEEP_PLANNER_MODEL=minimax-m2.7
DEEP_PLANNER_TIMEOUT_SECONDS=300
DEEP_PLANNER_REASONING_EFFORT=

# Vision QA model (can differ from planner model)
VISION_BASE_URL=http://metis.local:1240/v1
VISION_MODEL=qwen3.6-35b-a3b-mtp
VISION_TIMEOUT_SECONDS=60
VISION_REASONING_EFFORT=none

# AWS / Bedrock fallback
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-20250514
HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001
BEDROCK_VALIDATE=false

# Storage & jobs
SQLITE_PATH=data/slideforge.db
TEMPLATES_DIR=data/templates
JOBS_DIR=data/jobs
QA_MAX_ROUNDS=2
JOB_WORKER_CONCURRENCY=1

# Frontend
VITE_API_BASE_URL=http://localhost:8000
