        "body": {
          "shape_id": 3,
          "type": "text",
          "max_chars": 600,
          "required": true,
          "description": "Main content area — bullet points or key statistics"
        }
      },
      "notes": "Standard content slide. Use for bullet lists, key points, or statistics."
    },
    "section_divider": {
      "layout_name": "Section Header",
      "slide_layout_index": 2,
      "suitable_for": ["section_divider"],
      "fields": {
        "section_title": {
          "shape_id": 2,
          "type": "text",
          "max_chars": 60,
