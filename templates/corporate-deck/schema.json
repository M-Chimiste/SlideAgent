      "fields": {
        "deck_title": {
          "shape_id": 2,
          "type": "text",
          "max_chars": 100,
          "required": true,
          "description": "Main title of the deck"
        },
        "subtitle": {
          "shape_id": 3,
          "type": "text",
          "max_chars": 200,
          "required": false,
          "description": "Subtitle or tagline"
        }
      },
      "notes": "Opening slide. Use for deck title and optional subtitle."
    },
    "content_bullets": {
      "layout_name": "Title and Content",
      "slide_layout_index": 1,
      "suitable_for": ["bullets", "stat_callout"],
      "fields": {
        "slide_title": {
          "shape_id": 2,
          "type": "text",
          "max_chars": 80,
          "required": true,
          "description": "Slide heading"
